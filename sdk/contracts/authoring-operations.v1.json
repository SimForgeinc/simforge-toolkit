{
  "schema": "simforge.authoring-operations/v1",
  "transaction": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "baseVersion",
      "baseDigest",
      "label",
      "operations"
    ],
    "properties": {
      "baseVersion": {
        "type": "integer",
        "minimum": 0
      },
      "baseDigest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "label": {
        "type": "string",
        "minLength": 1
      },
      "operations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "type"
          ]
        }
      }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "actorId": {
          "type": "string"
        }
      }
    },
    "documentTransactionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "version",
        "digest",
        "changedPaths",
        "entityIds",
        "diagnostics",
        "inverseDocument"
      ],
      "properties": {
        "document": {
          "type": "object"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "changedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entityIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "inverseDocument": {
          "type": "object"
        }
      }
    }
  },
  "refusals": [
    "stale_version",
    "stale_digest",
    "revision_overflow",
    "actor_unknown",
    "duplicate_actor",
    "unknown_catalog_id",
    "actor_family_unsupported",
    "placement_no_lane",
    "spawn_overlap",
    "overlap_override_forbidden",
    "ego_ineligible",
    "static_motion_refused",
    "timed_route_speed_owned",
    "route_timing_infeasible",
    "event_time_outside_clip",
    "map_context_missing"
  ],
  "operations": [
    {
      "id": "addActor",
      "summary": "Place a new actor: a road vehicle on a semantic lane, or a pedestrian/free static actor at a scene point.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "catalogId"
        ],
        "properties": {
          "type": {
            "const": "addActor",
            "description": "Operation id."
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "description": "New actor id (never allocated implicitly)."
          },
          "catalogId": {
            "type": "string",
            "description": "Built-in actor (`simforge scenario actors`): vehicle.sedan, pedestrian.adult, ..."
          },
          "laneRsl": {
            "type": "string",
            "pattern": "^-?[0-9]+:[0-9]+:-?[0-9]+$",
            "description": "Semantic lane `road:section:lane` (with s)."
          },
          "s": {
            "type": "number",
            "description": "Station along laneRsl in storage direction.",
            "minimum": 0,
            "x-unit": "m"
          },
          "x": {
            "type": "number",
            "description": "Scene-frame x (east).",
            "x-unit": "m"
          },
          "z": {
            "type": "number",
            "description": "Scene-frame z (minus north).",
            "x-unit": "m"
          },
          "y": {
            "type": "number",
            "description": "Explicit height; otherwise the map ground at (x,z) is used and refused without ground.",
            "x-unit": "m"
          },
          "headingRad": {
            "type": "number",
            "description": "Heading in the scene frame; default: the lane heading or the actor class default.",
            "x-unit": "rad"
          },
          "lateralM": {
            "type": "number",
            "description": "Lateral offset in the lane, positive to the left of travel.",
            "x-unit": "m"
          },
          "overlapOverride": {
            "type": "boolean",
            "default": false,
            "description": "Accept overlap with another actor (free/static actors only; refused for moving road vehicles)."
          },
          "opposing": {
            "type": "boolean",
            "default": false,
            "description": "Snap to the nearest genuinely opposing lane."
          },
          "static": {
            "type": "boolean",
            "default": false,
            "description": "Place as a static actor (no motion, zero speed)."
          },
          "speedKph": {
            "type": "number",
            "description": "Initial speed; default: posted limit for road vehicles.",
            "minimum": 0,
            "maximum": 160,
            "x-unit": "km/h"
          },
          "bodyColor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "Presentation body colour `#rrggbb`."
          },
          "label": {
            "type": "string",
            "maxLength": 80,
            "description": "Display label."
          }
        },
        "oneOf": [
          {
            "required": [
              "laneRsl",
              "s"
            ]
          },
          {
            "required": [
              "x",
              "z"
            ]
          }
        ]
      },
      "resultSchema": {
        "$ref": "#/$defs/documentTransactionResult"
      },
      "applicability": {
        "targets": "document",
        "actorFamilies": [
          "road_vehicle",
          "pedestrian",
          "static"
        ],
        "rules": [
          "moving road vehicles require laneRsl+s or a point that snaps to a lane",
          "pedestrians and free static actors use scene points",
          "motor-vehicle overlap cannot be overridden"
        ]
      },
      "effectCategory": "document",
      "requiredContext": [
        "placement",
        "ground"
      ],
      "diagnostics": [
        "stale_version",
        "stale_digest",
        "revision_overflow",
        "template_invalid",
        "duplicate_actor",
        "unknown_catalog_id",
        "actor_family_unsupported",
        "placement_no_lane",
        "spawn_overlap",
        "overlap_override_forbidden",
        "map_context_missing"
      ]
    },
